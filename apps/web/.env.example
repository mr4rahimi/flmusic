# ---------------------------------------------------------------------------
# آدرس عمومی سایت (بدون اسلش انتهایی)
# مبنای canonical، sitemap، robots و متادیتای OpenGraph است.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://flmusic.ir

# آدرس پایه‌ی API (شامل prefix نسخه) — نسخه‌ی عمومی
NEXT_PUBLIC_API_URL=https://flmusic.ir/api/v1

# آدرس داخلی API برای درخواست‌های سمت سرور (اختیاری).
# روی سرور به 127.0.0.1 اشاره کنید تا رفت‌وبرگشت از CDN حذف شود.
API_INTERNAL_URL=http://127.0.0.1:3000/api/v1

# ریشه‌ی فایل‌های استاتیک (کاور، آواتار، فایل صوتی)
# مقادیر coverUrl/audioUrl در دیتابیس نسبی‌اند: uploads/covers/xxx.jpg
NEXT_PUBLIC_MEDIA_URL=https://flmusic.ir

# کد تأیید مالکیت گوگل سرچ کنسول (اختیاری، متاتگ google-site-verification)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# مدت کش صفحات عمومی بر حسب ثانیه (ISR)
REVALIDATE_SECONDS=300
