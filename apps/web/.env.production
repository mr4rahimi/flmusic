# مقادیر پروداکشن — هنگام build خوانده می‌شوند.
# نکته: متغیرهای NEXT_PUBLIC_* در زمان build درون باندل نوشته می‌شوند،
# پس تغییرشان بدون build دوباره اثری ندارد.

NEXT_PUBLIC_SITE_URL=https://flmusic.ir

# آدرس عمومی API (در صورت نیاز کلاینت به آن).
# زیردامنه‌ی api.flmusic.ir هم از قبل روی سرور به همین سرویس اشاره می‌کند.
NEXT_PUBLIC_API_URL=https://flmusic.ir/api/v1

# آدرس داخلی API برای درخواست‌های سمت سرور — از CDN عبور نمی‌کند.
# NEXT_PUBLIC_ نیست، پس به مرورگر ارسال نمی‌شود.
API_INTERNAL_URL=http://127.0.0.1:3000/api/v1

# ریشه‌ی فایل‌های استاتیک؛ باید عمومی باشد چون مرورگر تصاویر را از آن می‌گیرد
NEXT_PUBLIC_MEDIA_URL=https://flmusic.ir

NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
REVALIDATE_SECONDS=300

# لینک دانلود اپلیکیشن فندوق (اختیاری).
# تا وقتی خالی باشد، دکمه‌ی دانلود در صفحه‌ی اصلی رندر نمی‌شود.
NEXT_PUBLIC_APP_DOWNLOAD_URL=
